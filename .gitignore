# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Frontend build output ────────────────────────────────────────────────────
/dist/
*.tsbuildinfo
.vite/
vite.config.ts.timestamp-*

# ── Rust / Tauri ─────────────────────────────────────────────────────────────
# Build output and the schemas `tauri build` regenerates
/src-tauri/target/
/src-tauri/gen/
**/*.rs.bk

# Mobile icons that `tauri icon` generates; this is a desktop-only app
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Updater / code-signing keys must never be committed
*.key
*.key.pub
*.pem
*.p12
*.cer
*.provisionprofile

# ── Test output ──────────────────────────────────────────────────────────────
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/coverage/

# ── Environment and local overrides ──────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs and temporary files ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.tmp.*

# ── Editors and tools ────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.claude/settings.local.json

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
